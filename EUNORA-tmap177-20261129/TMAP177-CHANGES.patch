+            outcome = TmapAcceptResult.UNKNOWN
+        } finally {
+            runCatching { connection?.disconnect() }
+            val finalOutcome = outcome
+            val finalCode = code
+            handler.post {
+                refreshSession()
+                val context = ModuleMain.getApplicationContext()
