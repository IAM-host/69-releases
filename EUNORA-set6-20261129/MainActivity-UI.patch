+                    downX = event.x
+                    downY = event.y
+                    lastX = event.x
+                    dragging = false
+                    verticalGesture = false
+                    return true
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    val dx = kotlin.math.abs(event.x - downX)
+                    val dy = kotlin.math.abs(event.y - downY)
+                    if (!dragging && !verticalGesture) {
+                        if (dy > touchSlop && dy >= dx) verticalGesture = true
+                        else if (dx > touchSlop && dx > dy * 1.2f) {
+                            dragging = true
+                            parent?.requestDisallowInterceptTouchEvent(true)
+                        }
+                    }
+                    if (dragging) {
+                        val nextX = (scrollX + lastX - event.x).toInt()
+                            .coerceIn(0, (childCount - 1).coerceAtLeast(0) * width)
+                        scrollTo(nextX, 0)
+                    }
+                    lastX = event.x
+                    return true
+                }
+                MotionEvent.ACTION_UP -> {
+                    if (dragging && width > 0) {
